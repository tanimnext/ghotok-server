{
  "name": "ghotok-server",
  "version": "2.0.0",
  "private": true,
  "description": "Ghotok REST API \u2014 Node.js, Express, MongoDB and Better Auth.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "start": "node --env-file-if-exists=.env index.js",
    "seed": "node --env-file-if-exists=.env index.js seed",
    "seed:demo": "node --env-file-if-exists=.env index.js seed --demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "db:stop": "node index.js db:stop"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.6.2",
    "supertest": "^7.3.1",
    "vitest": "^4.1.12"
  }
}
