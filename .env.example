# ---- Core ----
NODE_ENV=development
PORT=4000
# MUST be the same database as MONGODB_URI in ghotok-client: the website stores accounts and
# sessions there (Better Auth) and this API reads them.
# Local MongoDB, or a MongoDB Atlas string such as
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ghotok?retryWrites=true&w=majority
# In development, when nothing answers at the default address, the server starts its own
# MongoDB in the background (data in .data/mongo; stop it with `npm run db:stop`).
MONGODB_URI=mongodb://127.0.0.1:27017/ghotok

# Public URLs. CLIENT_URL is the website (members and admins use the same site).
# API_PUBLIC_URL is this API's own address.
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:3000

# ---- Sessions ----
# MUST be the same value as BETTER_AUTH_SECRET in ghotok-client: it checks the signature of
# the session cookie the website sets. At least 32 random characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0123456789

# ---- The first admin (created by `npm run seed`). Every other account starts as a member. ----
SEED_ADMIN_EMAIL=admin@ghotok.com.bd
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Ghotok Admin

LOG_LEVEL=info
