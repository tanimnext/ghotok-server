# ---- Core ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ghotok

# Public URLs. CLIENT_URL is the website (members and admins use the same site);
# payment gateways send people back there. API_PUBLIC_URL is where gateways call back.
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:3000

# ---- Auth (Better Auth) ----
# The public URL the browser uses to reach /api/auth. The client proxies /api to this
# server, so this is normally the website's URL.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0123456789
COOKIE_SECURE=false
REQUIRE_VERIFICATION=true
# Logs one-time codes so you can sign in without SMS/email. NEVER in production.
OTP_DEV_ECHO=true

# ---- Email (SMTP). Leave SMTP_HOST empty to print emails to the log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ghotok <no-reply@ghotok.com.bd>

# ---- SMS. Leave empty to print SMS to the log ----
# Any GET-based Bangladeshi SMS API works; {number} becomes 8801XXXXXXXXX and {message} the text. Example (BulkSMSBD):
# SMS_API_URL=http://bulksmsbd.net/api/smsapi?api_key=YOUR_KEY&type=text&senderid=YOUR_SENDER_ID&number={number}&message={message}
SMS_API_URL=

# ---- Sign in with Google (optional) ----
# Create an OAuth client (Web application) in Google Cloud Console with the redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google. Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Payment gateways (optional) ----
# Without keys, bKash/Nagad/Rocket all work through "Send Money + transaction ID" with admin verification.
BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_ENABLED=false
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=

# SSLCommerz hosted checkout: cards, mobile banking and internet banking on one page.
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ---- The first admin (created by `npm run seed`). Every other account starts as a member. ----
SEED_ADMIN_EMAIL=admin@ghotok.com.bd
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Ghotok Admin

LOG_LEVEL=info
