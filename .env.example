# ---- Core ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ghotok

# Public URLs (used for payment callbacks, redirects and CORS)
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Auth ----  (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_UPLOAD_SECRET=dev-upload-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=.ghotok.com.bd
COOKIE_SECURE=false
REQUIRE_VERIFICATION=true
# Returns OTP codes in API responses so you can test without SMS/email. NEVER in production.
OTP_DEV_ECHO=true

# ---- Email (SMTP). Leave SMTP_HOST empty to print emails to the log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ghotok <no-reply@ghotok.com.bd>

# ---- SMS. Leave empty to print SMS to the log ----
# Any GET-based Bangladeshi SMS API works; {number} becomes 8801XXXXXXXXX and {message} the text. Example (BulkSMSBD):
# SMS_API_URL=http://bulksmsbd.net/api/smsapi?api_key=YOUR_KEY&type=text&senderid=YOUR_SENDER_ID&number={number}&message={message}
SMS_API_URL=

# ---- Media storage ----
# local = files on this server (development). cloudflare = Cloudflare Images (photos) + R2 (NID documents).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CF_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
CF_IMAGES_ACCOUNT_HASH=
# Set to make photos require signed, expiring URLs (recommended)
CF_IMAGES_SIGNING_KEY=
CF_IMAGES_VARIANT=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ghotok-private

# ---- Sign in with Google (optional) ----
# Create an OAuth client (Web application) in Google Cloud Console with the redirect URI
# <API_PUBLIC_URL>/api/auth/google/callback. Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Payment gateways (optional) ----
# Without keys, bKash/Nagad/Rocket all work through "Send Money + transaction ID" with admin verification.
BKASH_ENABLED=false
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_ENABLED=false
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=

# SSLCommerz hosted checkout: cards, mobile banking and internet banking on one page.
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ---- First super admin (created by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@ghotok.com.bd
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Super Admin

LOG_LEVEL=info
